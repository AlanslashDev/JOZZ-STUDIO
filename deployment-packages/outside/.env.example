APP_ENV=production
APP_URL=https://example.com
ADMIN_ORIGIN=https://example.com
ALLOWED_ORIGINS=https://example.com
API_BASE_URL=/api/v1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jooz_db
DB_USER=jooz_app
DB_PASSWORD=replace-with-a-long-random-password
CACHE_TTL=3600
SESSION_NAME=joozz_admin
SESSION_SECURE=true
# Set true only when a trusted reverse proxy sets X-Forwarded-Proto.
TRUST_PROXY=false
UPLOAD_MAX_BYTES=26214400
